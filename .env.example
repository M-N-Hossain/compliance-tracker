# Copy this file to .env and fill in your own values. Never commit .env.

# Database. The three POSTGRES_* values are used by docker compose to create the
# database. Compose also builds the app's DATABASE_URL from them (with host "db").
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=your-db-name

# Only used when you run the app on your laptop with "npm run dev" (host is localhost).
# Keep the user, password and database name the same as above.
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/your-db-name

# Auth.js signing secret. Generate one with: npx auth secret
AUTH_SECRET=generate-a-random-secret

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare R2 (file storage, private bucket)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
