# Fake values for automated tests. This file is committed, so never put a real key here.
# test/safety-test/env-safety.test.ts fails if a value below stops looking fake.

# Test database, on its own port. Your development database uses 5432.
POSTGRES_USER=fake-db-user
POSTGRES_PASSWORD=fake-db-password
POSTGRES_DB=compliance_tracker_test
DATABASE_URL=postgresql://fake-db-user:fake-db-password@localhost:5433/compliance_tracker_test

# Auth.js signing secret
AUTH_SECRET=fake-auth-secret

# Google Gemini API key
GEMINI_API_KEY=fake-gemini-api-key

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=fake-account-id
R2_ACCESS_KEY_ID=fake-access-key-id
R2_SECRET_ACCESS_KEY=fake-secret-access-key
R2_BUCKET=fake-bucket
