// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  companyId    Int?     @unique
  company      Company? @relation(fields: [companyId], references: [id])
}

model Company {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String
  category            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  documents           Document[]
  pendingRequirements PendingRequirement[]
  user User?
}

model RequirementTemplate {
  id            Int        @id @default(autoincrement())
  category      String
  name          String
  renewalPeriod String
  documents     Document[]

  @@unique([category, name])
}

enum PendingStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model PendingRequirement {
  id              Int           @id @default(autoincrement())
  category        String
  name            String
  status          PendingStatus @default(PENDING_REVIEW)
  sourceCompanyId Int
  sourceCompany   Company       @relation(fields: [sourceCompanyId], references: [id])
  documentId      Int?          @unique
  document        Document?     @relation(fields: [documentId], references: [id])
  createdAt       DateTime      @default(now())
}

model Document {
  id                    Int                  @id @default(autoincrement())
  companyId             Int
  company               Company              @relation(fields: [companyId], references: [id])
  requirementTemplateId Int?
  requirementTemplate   RequirementTemplate? @relation(fields: [requirementTemplateId], references: [id])
  fileUrl               String
  extractedType         String?
  expiryDate            DateTime?
  createdAt             DateTime             @default(now())
  pendingRequirement    PendingRequirement?

}
